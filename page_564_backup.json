escaped-html\", \"value\": \"<script>\\njQuery(function($) {\\n  var diasInfo = {\\n    'lunes': {'title': 'MEN\\u00da DEL LUNES', 'badge': '\\ud83c\\udf72 D\\u00eda de Caldos Reconfortantes', 'desc': 'Arranca la semana laboral con energ\\u00eda criolla y guisos reconfortantes de olla honda.'},\\n    'martes': {'title': 'MEN\\u00da DEL MARTES', 'badge': '\\ud83e\\udd69 Paila de Res & Guisos', 'desc': 'Falda deshilachada a mano y carnes estofadas en sofrito paname\\u00f1o a fuego lento.'},\\n    'miercoles': {'title': 'MEN\\u00da DEL MI\\u00c9RCOLES', 'badge': '\\ud83c\\udf72 Paila Criolla Campesina', 'desc': 'Saz\\u00f3n de fonda interiorana para recargar energ\\u00eda a mitad de semana.'},\\n    'jueves': {'title': 'MEN\\u00da DEL JUEVES', 'badge': '\\ud83c\\udf56 Asados & Estofados', 'desc': 'Puerco liso asado, bistec picado y cortes jugosos al estilo interiorano.'},\\n    'viernes': {'title': 'MEN\\u00da DEL VIERNES', 'badge': '\\ud83d\\udc1f Especial Costero del Viernes', 'desc': 'Corvina frita fresca, arroz con mariscos y patacones al estilo de la costa.'},\\n    'sabado': {'title': 'MEN\\u00da DEL S\\u00c1BADO', 'badge': '\\ud83c\\udf89 Paila de S\\u00e1bado Familiar', 'desc': 'Lechona crujiente, sancocho de patio y costillitas en barbacoa de raspadura.'}\\n  };\\n\\n  var diasList = ['domingo', 'lunes', 'martes', 'miercoles', 'jueves', 'viernes', 'sabado'];\\n  var hoy = diasList[new Date().getDay()] === 'domingo' ? 'lunes' : diasList[new Date().getDay()];\\n\\n  function activarDia(dia) {\\n    if (!diasInfo[dia]) dia = 'lunes';\\n\\n    // 1. P\\u00edldoras\\n    $('[configuration-id^=\\\"pill-\\\"]').each(function() {\\n      var cfg = $(this).attr('configuration-id');\\n      if (cfg === 'pill-' + dia) {\\n        $(this).css({\\n          'background-color': '#F59E0B',\\n          'border-color': '#F59E0B',\\n          'box-shadow': '0 2px 6px rgba(245,158,11,0.25)'\\n        });\\n      } else {\\n        $(this).css({\\n          'background-color': '#FFFFFF',\\n          'border-color': '#E5E7EB',\\n          'box-shadow': 'none'\\n        });\\n      }\\n    });\\n\\n    // 2. Banner\\n    var info = diasInfo[dia];\\n    $('[configuration-id=\\\"banner-day-title\\\"] h3, [configuration-id=\\\"banner-day-title\\\"]').text(info.title);\\n    $('[configuration-id=\\\"banner-day-badge\\\"]').text(info.badge);\\n    $('[configuration-id=\\\"banner-day-desc\\\"]').text(info.desc);\\n\\n    // 3. Grid de platos\\n    $('[configuration-id^=\\\"grid-\\\"]').hide().css('display', 'none');\\n    var $activeGrid = $('[configuration-id=\\\"grid-' + dia + '\\\"]');\\n    $activeGrid.css('display', 'flex').hide().fadeIn(250);\\n  }\\n\\n  activarDia(hoy);\\n\\n  $(document).on('click', '[configuration-id^=\\\"pill-\\\"]', function(e) {\\n    e.preventDefault();\\n    var cfg = $(this).attr('configuration-id');\\n    var dia = cfg.replace('pill-', '');\\n    activarDia(dia);\\n  });\\n\\n  $(document).on('click', '.woosq-btn', function(e) {\\n    e.preventDefault();\\n    var pid = $(this).attr('data-id');\\n    if (typeof woosq_open === 'function') {\\n      woosq_open(pid);\\n    }\\n  });\\n});\\n</script>\\n<style>\\n    .woosq-btn {\\n      color: #FFFFFF !important;\\n      background-color: #F59E0B !important;\\n      border-radius: 24px !important;\\n      font-weight: 700 !important;\\n      font-size: 15px !important;\\n      border: none !important;\\n      transition: all 0.2s ease;\\n      box-shadow: 0 4px 10px rgba(245, 158, 11, 0.3) !important;\\n      text-transform: none !important;\\n    }\\n    .woosq-btn:hover {\\n      background-color: #D97706 !important;\\n      transform: translateY(-2px);\\n    }\\n  </style>\"}}, \"elements\": [], \"widgetType\": \"e-paragraph\", \"styles\": {\"e-464bb1bd-e542\": {\"id\": \"e-464bb1bd-e542\", \"label\": \"local\", \"type\": \"class\", \"variants\": [{\"meta\": {\"breakpoint\": \"desktop\", \"state\": null}, \"props\": {\"display\": {\"$$type\": \"string\", \"value\":