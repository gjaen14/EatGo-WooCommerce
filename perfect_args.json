div>\n      <div class=\"eg-dish-body\">\n        <div>\n          <h4 class=\"eg-dish-title\">Costillitas en Barbacoa de Raspadura</h4>\n          <p class=\"eg-dish-desc\">Costillas tiernas de cerdo ba\u00f1adas en reducci\u00f3n artesanal de miel de ca\u00f1a/raspadura y aj\u00ed chombo dulce.</p>\n          <div class=\"eg-side-selector-label\">Acompa\u00f1amiento a tu gusto:</div>\n          <div class=\"eg-side-selector-box\">\n            <span>Patacones Crujientes</span>\n            <span>\u2335</span>\n          </div>\n        </div>\n        <div>\n          <a href=\"#\" class=\"eg-btn-add woosq-btn\" data-id=\"154\">\n            \ud83d\udecd\ufe0f + Agregar al Pedido\n          </a>\n        </div>\n      </div>\n    </div>\n  </div>\n  <script>\njQuery(function($) {\n  var diasInfo = {\n    'lunes': {\n      'title': 'MEN\u00da DEL LUNES',\n      'badge': '\ud83c\udf72 D\u00eda de Caldos Reconfortantes',\n      'desc': 'Arranca la semana laboral con energ\u00eda criolla y guisos reconfortantes de olla honda.'\n    },\n    'martes': {\n      'title': 'MEN\u00da DEL MARTES',\n      'badge': '\ud83e\udd69 Paila de Res & Guisos',\n      'desc': 'Falda deshilachada a mano y carnes estofadas en sofrito paname\u00f1o a fuego lento.'\n    },\n    'miercoles': {\n      'title': 'MEN\u00da DEL MI\u00c9RCOLES',\n      'badge': '\ud83c\udf72 Paila Criolla Campesina',\n      'desc': 'Saz\u00f3n de fonda interiorana para recargar energ\u00eda a mitad de semana.'\n    },\n    'jueves': {\n      'title': 'MEN\u00da DEL JUEVES',\n      'badge': '\ud83c\udf56 Asados & Estofados',\n      'desc': 'Puerco liso asado, bistec picado y cortes jugosos al estilo interiorano.'\n    },\n    'viernes': {\n      'title': 'MEN\u00da DEL VIERNES',\n      'badge': '\ud83d\udc1f Especial Costero del Viernes',\n      'desc': 'Corvina frita fresca, arroz con mariscos y patacones al estilo de la costa.'\n    },\n    'sabado': {\n      'title': 'MEN\u00da DEL S\u00c1BADO',\n      'badge': '\ud83c\udf89 Paila de S\u00e1bado Familiar',\n      'desc': 'Lechona crujiente, sancocho de patio y costillitas en barbacoa de raspadura.'\n    }\n  };\n\n  var diasSemana = ['domingo', 'lunes', 'martes', 'miercoles', 'jueves', 'viernes', 'sabado'];\n  var numDiaHoy = new Date().getDay();\n  var diaHoy = diasSemana[numDiaHoy] === 'domingo' ? 'lunes' : diasSemana[numDiaHoy];\n\n  function activarDia(dia) {\n    if (!diasInfo[dia]) dia = 'lunes';\n\n    // 1. Cambiar estado de p\u00edldoras\n    $('.eg-day-pill').removeClass('is-active');\n    $('.eg-day-pill[data-target=\"' + dia + '\"]').addClass('is-active');\n\n    // 2. Cambiar banner amarillo\n    var info = diasInfo[dia];\n    $('#eg-banner-day-title').text(info.title);\n    $('#eg-banner-badge').text(info.badge);\n    $('#eg-banner-desc').text(info.desc);\n\n    // 3. Mostrar el grid correspondiente y ocultar el resto\n    $('.eg-dishes-grid').hide().css('display', 'none');\n    $('#day-grid-' + dia).fadeIn(200).css('display', 'grid');\n  }\n\n  // Activar d\u00eda actual al cargar\n  activarDia(diaHoy);\n\n  // Escuchar clics en las p\u00edldoras\n  $(document).on('click', '.eg-day-pill', function(e) {\n    e.preventDefault();\n    var diaSeleccionado = $(this).attr('data-target');\n    if (diaSeleccionado) {\n      activarDia(diaSeleccionado);\n    }\n  });\n\n  // Asegurar compatibilidad con WPC Quick View\n  $(document).on('click', '.woosq-btn', function(e) {\n    e.preventDefault();\n    var pid = $(this).attr('data-id');\n    if (typeof woosq_open === 'function') {\n      woosq_open(pid);\n    }\n  });\n});\n</script>\n\n</div>"
