{
  "version": "0.4",
  "title": "Eat&Go - Sticky Comanda Bar (Pill Bar)",
  "type": "container",
  "content": [
    {
      "id": "stk0001",
      "elType": "container",
      "settings": {
        "content_width": "full",
        "flex_direction": "row",
        "flex_justify_content": "space-between",
        "flex_align_items": "center",
        "padding": { "unit": "px", "top": "10", "right": "18", "bottom": "10", "left": "18", "isLinked": false },
        "background_background": "classic",
        "background_color": "#18181B",
        "border_border": "solid",
        "border_width": { "unit": "px", "top": "1", "right": "1", "bottom": "1", "left": "1", "isLinked": true },
        "border_color": "rgba(255,255,255,0.1)",
        "border_radius": { "unit": "px", "top": "50", "right": "50", "bottom": "50", "left": "50", "isLinked": true },
        "box_shadow_box_shadow_type": "yes",
        "box_shadow_box_shadow": {
          "horizontal": 0,
          "vertical": 12,
          "blur": 36,
          "spread": 0,
          "color": "rgba(0,0,0,0.45)"
        },
        "custom_css": "selector { position: fixed; bottom: 24px; left: 50%; transform: translateX(-50%); z-index: 9999; max-width: 720px; width: calc(100% - 32px); font-family: 'Open Sans', sans-serif; transition: all 0.4s ease; }\n@media (max-width: 767px) { selector { padding: 8px 12px; gap: 8px; } }"
      },
      "elements": [
        {
          "id": "stk0002",
          "elType": "container",
          "settings": {
            "flex_direction": "row",
            "flex_align_items": "center",
            "flex_gap": { "unit": "px", "size": 14 }
          },
          "elements": [
            {
              "id": "stk0003",
              "elType": "container",
              "settings": {
                "width": { "unit": "px", "size": 42 },
                "height": { "unit": "px", "size": 42 },
                "background_background": "classic",
                "background_color": "#F59E0B",
                "border_radius": { "unit": "px", "top": "12", "right": "12", "bottom": "12", "left": "12", "isLinked": true },
                "flex_justify_content": "center",
                "flex_align_items": "center",
                "custom_css": "selector { position: relative; flex-shrink: 0; }"
              },
              "elements": [
                {
                  "id": "stk0004",
                  "elType": "widget",
                  "widgetType": "text-editor",
                  "settings": {
                    "editor": "<span style=\"font-size:20px; line-height:1;\">🛍️</span><span class=\"sticky-cart-count\" style=\"position:absolute; top:-4px; right:-4px; width:18px; height:18px; border-radius:50%; background:#ffffff; color:#0c0a09; font-size:10px; font-weight:900; display:flex; align-items:center; justify-content:center; border:2px solid #18181b; line-height:1;\">1</span>"
                  }
                }
              ]
            },
            {
              "id": "stk0005",
              "elType": "container",
              "settings": {
                "flex_direction": "column",
                "flex_gap": { "unit": "px", "size": 3 }
              },
              "elements": [
                {
                  "id": "stk0006",
                  "elType": "container",
                  "settings": {
                    "flex_direction": "row",
                    "flex_align_items": "center",
                    "flex_gap": { "unit": "px", "size": 8 }
                  },
                  "elements": [
                    {
                      "id": "stk0007",
                      "elType": "widget",
                      "widgetType": "heading",
                      "settings": {
                        "title": "$9.50",
                        "title_color": "#FFFFFF",
                        "typography_typography": "custom",
                        "typography_font_family": "Open Sans",
                        "typography_font_size": { "unit": "px", "size": 18 },
                        "typography_font_weight": "700"
                      }
                    },
                    {
                      "id": "stk0008",
                      "elType": "widget",
                      "widgetType": "text-editor",
                      "settings": {
                        "editor": "<span style=\"border:1px solid #EAB308; color:#EAB308; font-size:10px; font-weight:700; padding:2px 6px; border-radius:4px; text-transform:uppercase; letter-spacing:0.02em;\">Empaque Térmico Incl.</span>"
                      }
                    }
                  ]
                },
                {
                  "id": "stk0009",
                  "elType": "widget",
                  "widgetType": "text-editor",
                  "settings": {
                    "editor": "<p style=\"margin:0; font-size:11px; color:#A1A1AA; line-height:1.2;\">1 plato • Despacho a oficina</p>"
                  }
                }
              ]
            }
          ]
        },
        {
          "id": "stk0010",
          "elType": "widget",
          "widgetType": "button",
          "settings": {
            "text": "Ver Comanda &amp; Despachar →",
            "link": {
              "url": "#elementor-action:action=popup:open&settings=eyJpZCI6IjMyNiIsInRvZ2dsZSI6ZmFsc2V9"
            },
            "button_text_color": "#0C0A09",
            "background_color": "#00C853",
            "border_radius": { "unit": "px", "top": "50", "right": "50", "bottom": "50", "left": "50", "isLinked": true },
            "typography_typography": "custom",
            "typography_font_family": "Open Sans",
            "typography_font_size": { "unit": "px", "size": 14 },
            "typography_font_weight": "900",
            "padding": { "unit": "px", "top": "12", "right": "24", "bottom": "12", "left": "24", "isLinked": false },
            "custom_css": "selector a { box-shadow: 0 4px 16px rgba(0,200,83,0.35); white-space: nowrap; transition: all 0.2s ease; }\nselector a:hover { background-color: #059669 !important; color: #ffffff !important; }"
          }
        }
      ]
    }
  ]
}
