                "custom_css": "selector { flex-grow: 1; }\nselector a, selector button { width: 100%; display: flex; align-items: center; justify-content: center; text-align: center; box-shadow: 0 4px 12px rgba(245, 158, 11, 0.35); transition: all 0.2s ease; cursor: pointer; }\nselector a:hover, selector button:hover { background-color: #D97706; transform: translateY(-1px); box-shadow: 0 6px 16px rgba(217, 119, 6, 0.4); }\nselector a:active, selector button:active { transform: scale(0.98); }",
                "_css_classes": "btn-modal-add-comanda btn-add-to-comanda-action"
              }
            }
          ]
        },
        {
          "id": "mod0027",
          "elType": "widget",
          "widgetType": "html",
          "settings": {
            "html": "<script>\njQuery(function($) {\n  var activeProductId = null;\n  var basePrice = 0;\n  var currentQty = 1;\n  var sideExtra = 0;\n  var drinkExtra = 0;\n\n  function updateModalButton() {\n    var unitPrice = basePrice + sideExtra + drinkExtra;\n    var total = (unitPrice * currentQty).toFixed(2);\n    $(\".btn-modal-add-comanda .elementor-button-text, .btn-modal-add-comanda, .btn-add-to-comanda-action\").each(function() {\n      var $el = $(this).find(\".elementor-button-text\").length ? $(this).find(\".elementor-button-text\") : $(this);\n      $el.text(\"Agregar a la Comanda • $\" + total);\n    });\n    $(\".modal-qty-num, #eg-modal-qty\").text(currentQty);\n  }\n\n  // 1. CAPTURAR DATOS DE LA TARJETA CLICKEADA\n  $(document).on(\"click\", \".btn-open-plato-modal, [href*=\\\"popup:open\\\"], [data-product-title]\", function() {\n    var $btn = $(this).closest(\".btn-open-plato-modal\").length ? $(this).closest(\".btn-open-plato-modal\") : $(this);\n    if (!$btn.is(\"a\")) {\n      var $innerA = $btn.find(\"a\");\n      if ($innerA.length) $btn = $innerA;\n    }\n    var $card = $(this).closest(\".e-loop-item, .elementor-element, .e-flexbox\");\n\n    activeProductId = $btn.attr(\"data-product-id\") || $card.find(\"[data-product-id]\").attr(\"data-product-id\") || $card.find(\"[data-id]\").attr(\"data-id\");\n    var title = $btn.attr(\"data-product-title\") || $card.find(\"h3, h4, .elementor-heading-title\").first().text().trim();\n    var priceText = $btn.attr(\"data-product-price\") || $card.find(\".woocommerce-Price-amount, .badge_price, [data-id*=\\\"price\\\"]\").first().text().trim();\n    var imgSrc = $btn.attr(\"data-product-img\") || $card.find(\"img\").first().attr(\"src\");\n\n    // Parsear precio numérico\n    var cleanNum = priceText ? priceText.replace(/[^0-9.]/g, \"\") : \"0\";\n    basePrice = parseFloat(cleanNum) || 0;\n    currentQty = 1;\n    sideExtra = 0;\n    drinkExtra = 0;\n\n    // Reset de radios al abrir\n    $(\"input[name=\\\"pa_acompanamiento\\\"]\").prop(\"checked\", false);\n    $(\"input[name=\\\"pa_acompanamiento\\\"][value=\\\"guandu\\\"]\").prop(\"checked\", true);\n    $(\".eg-side-card\").removeClass(\"is-selected\").css({\"border-color\":\"#E5E7EB\", \"background-color\":\"#FFFFFF\"});\n    $(\".eg-side-card:first\").addClass(\"is-selected\").css({\"border-color\":\"#F59E0B\", \"background-color\":\"#FFFBEB\"});\n\n    $(\"input[name=\\\"addon_drink\\\"]\").prop(\"checked\", false);\n    $(\"input[name=\\\"addon_drink\\\"][value=\\\"none\\\"]\").prop(\"checked\", true);\n    $(\".eg-drink-card\").removeClass(\"is-selected\").css({\"border-color\":\"#E5E7EB\", \"background-color\":\"#FFFFFF\"});\n    $(\".eg-drink-card:first\").addClass(\"is-selected\").css({\"border-color\":\"#F59E0B\", \"background-color\":\"#FFFBEB\"});\n\n    // Actualizar Modal\n    if (title) {\n      $(\".modal-plato-title-dyn .elementor-heading-title, .modal-plato-title-dyn, .modal-plato-title\").text(title);\n    }\n    if (priceText) {\n      $(\".modal-plato-price-dyn .elementor-heading-title, .modal-plato-price-dyn div, .modal-plato-price-dyn, .modal-plato-price\").text(\"$\" + basePrice.toFixed(2));\n    }\n    if (imgSrc && imgSrc.indexOf(\"http\") === 0) {\n      $(\".modal-plato-hero-img, .modal-plato-hero\").css({\n        \"background-image\": \"url(\" + imgSrc + \")\",\n        \"background-size\": \"cover\",\n        \"background-position\": \"center center\"\n      });\n    }\n\n    updateModalButton();\n  });\n\n  // 2. CONTROLES DE CANTIDAD\n  $(document).on(\"click\", \".modal-qty-minus, #mod0023\", function(e) {\n    e.preventDefault();\n    if (currentQty > 1) {\n      currentQty--;\n      updateModalButton();\n    }\n  });\n\n  $(document).on(\"click\", \".modal-qty-plus, #mod0025\", function(e) {\n    e.preventDefault();\n    currentQty++;\n    updateModalButton();\n  });\n\n  // Opciones de acompañamiento\n  $(document).on(\"change\", \"input[name=\\\"pa_acompanamiento\\\"]\", function() {\n    $(\".eg-side-card\").removeClass(\"is-selected\").css({\"border-color\":\"#E5E7EB\", \"background-color\":\"#FFFFFF\"});\n    var $card = $(this).closest(\".eg-side-card\");\n    $card.addClass(\"is-selected\").css({\"border-color\":\"#F59E0B\", \"background-color\":\"#FFFBEB\"});\n    sideExtra = parseFloat($(this).data(\"extra\") || 0);\n    updateModalButton();\n  });\n\n  // Opciones de bebidas\n  $(document).on(\"change\", \"input[name=\\\"addon_drink\\\"]\", function() {\n    $(\".eg-drink-card\").removeClass(\"is-selected\").css({\"border-color\":\"#E5E7EB\", \"background-color\":\"#FFFFFF\"});\n    var $card = $(this).closest(\".eg-drink-card\");\n    $card.addClass(\"is-selected\").css({\"border-color\":\"#F59E0B\", \"background-color\":\"#FFFBEB\"});\n    drinkExtra = parseFloat($(this).data(\"price\") || 0);\n    updateModalButton();\n  });\n\n  // 3. ENVIAR A WOOCOMMERCE REAL AL CLIC\n  $(document).on(\"click\", \".btn-modal-add-comanda, .btn-add-to-comanda-action, #mod0026\", function(e) {\n    e.preventDefault();\n    var pId = activeProductId || 154; // Fallback al plato estrella si falta ID\n    var $btn = $(this);\n    var originalHtml = $btn.html();\n    $btn.css(\"opacity\", \"0.6\").text(\"Agregando a la comanda...\");\n\n    $.post(\"/?wc-ajax=add_to_cart\", {\n      product_id: pId,\n      quantity: currentQty\n    }, function(res) {\n      $btn.css(\"opacity\", \"1\").html(originalHtml);\n      // Disparar evento para que la barra flotante y el carrito se actualicen\n      if (res && res.fragments) {\n        $(document.body).trigger(\"added_to_cart\", [res.fragments, res.cart_hash, $btn]);\n      } else {\n        $(document.body).trigger(\"added_to_cart\");\n      }\n\n      // Cerrar Popup\n      if (window.elementorProFrontend && elementorProFrontend.modules && elementorProFrontend.modules.popup) {\n        elementorProFrontend.modules.popup.closePopup({}, e);\n      } else {\n        $(\".elementor-popup-modal\").hide();\n      }\n    }).fail(function() {\n      $btn.css(\"opacity\", \"1\").html(originalHtml);\n      if (window.elementorProFrontend && elementorProFrontend.modules && elementorProFrontend.modules.popup) {\n        elementorProFrontend.modules.popup.closePopup({}, e);\n      }\n    });\n  });\n});\n</script>"
          }
        }
      ]
    }
  ]
}